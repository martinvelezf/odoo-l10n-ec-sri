<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_sri" model="ir.ui.view">
        <field name="name">account.move.form.l10n_ec_sri</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sri_build_sign" type="object"
                        string="Sign (SRI)" class="btn-secondary"
                        invisible="move_type not in ('out_invoice','out_refund') or state != 'posted' or l10n_ec_sri_state not in ('draft','returned')"/>
                <button name="action_sri_send" type="object"
                        string="Send to SRI" class="btn-secondary"
                        invisible="l10n_ec_sri_state not in ('signed','returned')"/>
                <button name="action_sri_authorize" type="object"
                        string="Authorize (SRI)" class="btn-primary"
                        invisible="l10n_ec_sri_state != 'sent'"/>
                <field name="l10n_ec_sri_state" widget="statusbar"
                       invisible="move_type not in ('out_invoice','out_refund')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="sri" string="SRI e-Invoice"
                      invisible="move_type not in ('out_invoice','out_refund')">
                    <group>
                        <group>
                            <field name="l10n_ec_clave_acceso"/>
                            <field name="l10n_ec_sri_authorization"/>
                            <field name="l10n_ec_sri_authorization_date"/>
                        </group>
                        <group>
                            <field name="l10n_ec_sri_messages"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
